import os
import agent
import agent.tasks

# A clone starts with an empty database and its own generated passwords
# (see create-module): only the settings are copied from the source.
configure_retval = agent.tasks.run(
    agent_id=os.environ["AGENT_ID"],
    action="configure-module",
    data={
        "host": os.environ["TRAEFIK_HOST"],
        "http2https": os.environ["TRAEFIK_HTTP2HTTPS"] == "True",
        "lets_encrypt": os.environ["TRAEFIK_LETS_ENCRYPT"] == "True",
    },
)
agent.assert_exp(
    configure_retval["exit_code"] == 0, "The configure-module subtask failed!"
)
