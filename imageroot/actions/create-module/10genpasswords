import os
import secrets

# Generate the PostgreSQL password and the connection URL that Windmill
# uses to reach it. Secrets must not go through agent.set_env(), which
# stores values in Redis: keep them in a private file, included in the
# module backup (see etc/state-include.conf) and loaded by the systemd
# units. The password is hexadecimal, so it is safe inside a URL.
password = secrets.token_hex(16)
path = os.path.join(os.environ["AGENT_STATE_DIR"], "passwords.env")
fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as fp:
    fp.write(f"POSTGRES_PASSWORD={password}\n")
    fp.write(
        f"DATABASE_URL=postgres://postgres:{password}@127.0.0.1:5432/windmill?sslmode=disable\n"
    )
