# SPDX-License-Identifier: GPL-3.0-or-later
#

set -e

if ! systemctl --user -q is-active db-app.service; then
	exit 0
fi

# Dump the whole cluster, not just the "windmill" database: Windmill also
# keeps data table and fork databases and grants its row level security
# policies to cluster-level roles.
echo "Dumping the PostgreSQL cluster" 1>&2
podman exec db-app pg_dumpall -U postgres >windmill.sql.tmp
mv windmill.sql.tmp windmill.sql
