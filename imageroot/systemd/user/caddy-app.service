[Unit]
Description=Windmill Caddy gateway (port 80)
BindsTo=windmill.service
After=windmill.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/caddy-app.pid %t/caddy-app.ctr-id
# Write state/Caddyfile, which is not part of the backup
ExecStartPre=runagent write-caddyfile
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/caddy-app.pid \
    --cidfile=%t/caddy-app.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file=%t/windmill.pod-id \
    --replace --name=caddy-app \
    --volume=./Caddyfile:/etc/caddy/Caddyfile:ro,Z \
    ${CADDY_L4_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/caddy-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/caddy-app.ctr-id
PIDFile=%t/caddy-app.pid
Type=forking

[Install]
WantedBy=default.target
