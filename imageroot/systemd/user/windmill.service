#
# Pod master: creates the Windmill pod and publishes the Caddy gateway on
# the TCP port reserved for the module. Starting this unit does not start
# its children: list every service explicitly.
#

[Unit]
Description=Windmill pod
Requires=db-app.service server-app.service worker-app.service worker-native-app.service extra-app.service caddy-app.service
Before=db-app.service server-app.service worker-app.service worker-native-app.service extra-app.service caddy-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=-%E/state/environment
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/rm -f %t/windmill.pid %t/windmill.pod-id
ExecStartPre=/usr/bin/podman pod create \
    --infra-conmon-pidfile %t/windmill.pid \
    --pod-id-file %t/windmill.pod-id \
    --name windmill \
    --publish 127.0.0.1:${TCP_PORT}:80 \
    --replace
ExecStart=/usr/bin/podman pod start --pod-id-file %t/windmill.pod-id
ExecStop=/usr/bin/podman pod stop --ignore --pod-id-file %t/windmill.pod-id -t 10
ExecStopPost=/usr/bin/podman pod rm --ignore -f --pod-id-file %t/windmill.pod-id
PIDFile=%t/windmill.pid
Type=forking

[Install]
WantedBy=default.target
