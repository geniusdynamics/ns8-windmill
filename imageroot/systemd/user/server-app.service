[Unit]
Description=Windmill API server and web UI (port 8000)
BindsTo=windmill.service
After=windmill.service db-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# DATABASE_URL, generated by create-module (secret, mode 0600)
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/server-app.pid %t/server-app.ctr-id
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/server-app.pid \
    --cidfile=%t/server-app.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file=%t/windmill.pod-id \
    --replace --name=server-app \
    --volume=workerlogs:/tmp/windmill/logs:z \
    --env-file=passwords.env \
    --env=MODE=server \
    ${WINDMILL_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/server-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/server-app.ctr-id
PIDFile=%t/server-app.pid
Type=forking

[Install]
WantedBy=default.target
