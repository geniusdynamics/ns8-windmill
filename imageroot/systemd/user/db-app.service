[Unit]
Description=Windmill PostgreSQL database
BindsTo=windmill.service
After=windmill.service
Before=server-app.service worker-app.service worker-native-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# POSTGRES_PASSWORD and DATABASE_URL, generated by create-module (secret, mode 0600)
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/db-app.pid %t/db-app.ctr-id
# PostgreSQL 18 keeps the cluster in a versioned subdirectory: mount the
# parent directory, as the upstream image documentation requires.
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/db-app.pid \
    --cidfile=%t/db-app.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file=%t/windmill.pod-id \
    --replace --name=db-app \
    --volume=dbdata:/var/lib/postgresql:Z \
    --env=POSTGRES_DB=windmill \
    --env-file=passwords.env \
    ${POSTGRES_IMAGE}
# Wait for the real server on TCP: during the first initialization the
# image runs a temporary server that listens on the Unix socket only.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 60); do /usr/bin/podman exec db-app pg_isready -q -h 127.0.0.1 -U postgres && exit 0; sleep 1; done; exit 1'
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/db-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/db-app.ctr-id
PIDFile=%t/db-app.pid
Type=forking

[Install]
WantedBy=default.target
