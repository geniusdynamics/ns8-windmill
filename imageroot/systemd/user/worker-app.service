[Unit]
Description=Windmill default worker
BindsTo=windmill.service
After=windmill.service db-app.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
# DATABASE_URL, generated by create-module (secret, mode 0600)
EnvironmentFile=-%E/state/passwords.env
WorkingDirectory=%E/state
Restart=always
RestartSec=10
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/worker-app.pid %t/worker-app.ctr-id
ExecStart=/usr/bin/podman run \
    --detach \
    --conmon-pidfile=%t/worker-app.pid \
    --cidfile=%t/worker-app.ctr-id \
    --cgroups=no-conmon \
    --pod-id-file=%t/windmill.pod-id \
    --replace --name=worker-app \
    --volume=workerdependencycache:/tmp/windmill/cache:Z \
    --volume=workerlogs:/tmp/windmill/logs:z \
    --env-file=passwords.env \
    --env=MODE=worker \
    --env=WORKER_GROUP=default \
    ${WINDMILL_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/worker-app.ctr-id -t 10
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/worker-app.ctr-id
PIDFile=%t/worker-app.pid
Type=forking

[Install]
WantedBy=default.target
